{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macrokey",
  "version": "0.1.0",
  "identifier": "dev.macrokey.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "osd",
        "title": "macrokey",
        "url": "index.html",
        "width": 660,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "macrokey settings",
        "url": "settings.html",
        "width": 1080,
        "height": 700,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "center": false,
        "visible": false,
        "decorations": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
